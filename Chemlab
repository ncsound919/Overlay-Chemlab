    "logicFoundation": {
      "_rationale": "Every pipeline decision is a predicate over typed sets. Contracts (precondition Γƒ╣ postcondition) guard every external call. De Morgan rewriting and quantifier duality drive code-path simplification inside the LSP watcher.",
      "corePredicates": {
        "ValidFormula(s)":     "s Γêê String  Γêº  regex_enhanced matches s  Γêº  RDKit.get_mol(s) Γëá null",
        "SafeCompound(c)":     "ValidFormula(c)  Γêº  RiskScore(c) < threshold  Γêº  ┬¼Restricted(c)",
        "APIReachable(url)":   "┬¼disableExternalCalls  Γêº  lastPingLatency(url) < 5000ms",
        "CacheHit(key)":       "Γêâ entry Γêê inMemoryMap : entry.key = normalize(key)  Γêº  entry.ttl > now()",
        "HardwareAdequate()":  "navigator.hardwareConcurrency ΓëÑ 4  Γêº  WebGLSupported()",
        "AnalysisComplete(e)": "ΓêÇ mol Γêê e.molecules : ValidFormula(mol)  Γêº  Γêâ result Γêê e.results : result.cid = mol.cid"
      },
      "contracts": {
        "analyzeSelectionCommand": {
          "requires": "ValidFormula(selection)  Γêº  (CacheHit(selection)  Γê¿  APIReachable(pubchemBaseUrl))",
          "ensures":  "Γêâ report : report.smiles = canonical(selection)  Γêº  report.riskScore Γêê [0,1]"
        },
        "deepExperimentCommand": {
          "requires": "ΓêÇ mol Γêê parsedMolecules : ValidFormula(mol)  Γêº  APIReachable(cheminformaticsUrl)  Γêº  APIReachable(bioinformaticsUrl)",
          "ensures":  "AnalysisComplete(experiment)  Γêº  experiment.persistedInSupabase = true"
        },
        "renderTier": {
          "requires": "Γêâ asset : CacheHit(asset.key)  Γêº  (HardwareAdequate()  Γê¿  asset.tier = 'basic')",
          "ensures":  "pixiCanvas.children contains newSprite  Γêº  newSprite.zIndex ΓëÑ 100"
        },
        "suddenModelPlot": {
          "requires": "metal Γêê Object.keys(catalysisDFT.datasets)  Γêº  reaction Γêê catalysisDFT.reactions  Γêº  T Γêê [300,800]",
          "ensures":  "Γêâ plot : plot.title = `Reaction probability for ${reaction} on ${metal}`  Γêº  plot.data.length ΓëÑ 20"
        }
      },
      "decisionTable": {
        "_description": "Maps (cacheHit, apiReachable, hardwareAdequate) ΓåÆ rendering action. Exhaustive via truth-table (2┬│ = 8 rows), verified to be non-redundant.",
        "columns": ["CacheHit", "APIReachable", "HardwareAdequate", "Action"],
        "rows": [
