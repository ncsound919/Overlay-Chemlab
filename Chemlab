    "mathEngine": {
      "_rationale": "Hinton ΓÇô Essential Math for AI: linear algebra for molecular embeddings, probability for risk scoring, calculus/gradient-descent for property optimization, information theory for API result ranking, plus new catalysis modules.",
      "molecularEmbedding": {
        "_theory": "Represent each molecule as a d-dimensional real vector via Morgan fingerprints. Similarity = cosine(vΓéü, vΓéé) = (vΓéü┬╖vΓéé)/(ΓÇûvΓéüΓÇû┬╖ΓÇûvΓééΓÇû). Eigendecomposition of the similarity matrix surfaces molecular clusters without labels.",
        "dimension": 128,
        "fingerprintRadius": 2,
        "similarityMetric": "cosine",
        "clusteringMethod": "spectralClustering",
        "spectralClustering": {
          "steps": [
            "Build n├ùn similarity matrix S where S[i][j] = cosine(embed(molß╡ó), embed(molΓ▒╝))",
            "Compute normalized Laplacian L = I ΓêÆ D^(-┬╜) S D^(-┬╜)",
            "Take top-k eigenvectors of L ΓåÆ form n├ùk matrix U",
            "Run k-means on rows of U to assign cluster labels"
          ],
          "outputSchema": {
            "clusterId": "integer",
            "centroidSmiles": "string",
            "intraClusterVariance": "float"
          }
        }
      },
      "bayesianRiskScoring": {
        "_theory": "P(toxic | features) via Bayes: posterior Γê¥ likelihood ├ù prior. Features are the embedding vector. Prior from ChEMBL toxicity prevalence. Likelihood from a logistic regression trained on PubChem BioAssay outcomes.",
        "formula": "P(toxic|x) = ╧â(wß╡Çx + b)  where ╧â(z) = 1/(1+e^(-z))",
        "priorSource": "ChEMBL compound toxicity base rates",
        "likelihoodModel": "logisticRegression",
        "threshold": 0.65,
        "calibration": "Platt scaling post-hoc",
        "outputFields": {
          "posteriorRisk": "float [0,1]",
          "confidence95CI": "[float, float]",
          "dominantFeatures": "top-5 embedding dimensions by |wß╡ó|",
          "flagged": "boolean ΓÇö true if posteriorRisk ΓëÑ threshold"
        }
      },
      "propertyOptimization": {
        "_theory": "Gradient descent (Hinton ┬ºOptimization) on a differentiable scoring function f(x) = ΓêÆdesirability(x). Starting from the parsed molecule's embedding, take steps xΓéÖΓéèΓéü = xΓéÖ ΓêÆ ╬╖Γêçf(xΓéÖ) to suggest structurally similar but higher-scoring analogues.",
        "algorithm": "AdamW",
        "learningRate": 0.01,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-8,
        "maxIterations": 200,
        "convergenceCriterion": "ΓÇûΓêçf(x)ΓÇû < 1e-4",
        "scoringFunction": "desirability(x) = ╬▒┬╖druglikeness(x) + ╬▓┬╖(1ΓêÆtoxicity(x)) + ╬│┬╖selectivity(x)",
        "weights": { "alpha": 0.5, "beta": 0.35, "gamma": 0.15 },
        "output": "Top-3 optimized SMILES with ╬ödesirability vs. input"
      },
      "informationTheoreticRanking": {
        "_theory": "Rank API results by mutual information I(result ; query) = H(query) ΓêÆ H(query|result). Higher I means the result resolves more uncertainty about the query molecule. Used to sort multi-source results from PubChem, ChEMBL, and UniProt.",
        "entropyEstimation": "plugin estimator on fingerprint bit-vector distributions",
        "rankingMetric": "normalizedMutualInformation",
        "formula": "NMI(X;Y) = I(X;Y) / sqrt(H(X)┬╖H(Y))",
        "appliedTo": ["pubchemAssayResults", "chemblActivities", "uniprotTargets"],
        "outputOrder": "descending NMI ΓÇö most informative result first"
      },
      "loopInvariantVerification": {
        "_theory": "Wayne ┬º6.2.1 ΓÇö every batch-processing loop carries a formally checked invariant to guarantee termination and correctness.",
        "batchMoleculeLoop": {
          "invariant": "ΓêÇ i Γêê 0..<processed : ValidFormula(molecules[i])  Γêº  results[i].cid Γëá null",
          "terminationArgument": "processed strictly increases each iteration; bounded above by |molecules|",
          "onViolation": "abort batch, surface failing molecule index, emit structured error"
        }
      },
      "microkinetics": {
        "_theory": "Solve meanΓÇæfield rate equations for surface coverage using DFTΓÇæderived barriers and preΓÇæfactors.",
        "solver": "CVODE (via wasm) or embedded RungeΓÇæKutta",
        "odeSystem": "d╬╕_i/dt = ╬ú (rate of formation) - ╬ú (rate of consumption)",
        "temperatureRange": [300, 800],
        "pressureRange": [1e-6, 1],
        "output": "Coverage vs time, turnover frequency, rateΓÇædetermining degree of rate control"
      },
      "suddenModel": {
        "_theory": "Electronic (╬▓) and mechanical (╬▒) coupling parameters correct activation barrier for surface motion (equations 7ΓÇæ10 from paper).",
        "parameters": {
          "Pd_111": { "╬▓": 0.37, "╬▒": 0.12 },
          "Ti_Pd_111": { "╬▓": 0.42, "╬▒": 0.15 }
        },
        "reactionProbability": "P(E;T) = Γê½ ... (equation 9)",
        "temperatureDependence": "Equation 10 with recoil effect",
        "plot": "Reaction probability vs incident energy at selectable T"
      },
      "dBandCenter": {
        "_theory": "Center of dΓÇæprojected density of states relative to Fermi level. Higher (less negative) ΓåÆ stronger adsorption.",
        "computeFromDOS": "Γê½ E┬╖╧ü_d(E) dE / Γê½ ╧ü_d(E) dE",
        "inputFormat": "Array of {energy, dos} pairs",
        "output": "dΓÇæband center value in eV",
        "correlation": "Linear scaling with NO dissociation barrier (empirical)"
      }
    },

